# =============================================================================
# CoinHub .gitignore
# =============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
.eggs/

# Virtual environments
.venv/
venv/
ENV/
env/
.env.local
.env.production
.env.staging

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
backend/media/
backend/static/collected/
backend/staticfiles/

# Environment variables — NEVER commit these
.env
.env.*
!.env.example

# Docker
.docker/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Coverage / testing
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Migrations (keep these in version control — remove this line if you want to exclude)
# backend/apps/*/migrations/

# Node (if frontend build tools used)
node_modules/
npm-debug.log
yarn-error.log

# Secrets / keys
*.pem
*.key
*.crt
secrets/
