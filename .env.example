# =============================================================================
# CoinHub .env.example — TEMPLATE FILE
# Safe to commit to Git. Copy to .env for local usage.
# =============================================================================

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
DB_NAME=coinhub_db
DB_USER=coinhub_user
DB_PASSWORD=your_db_password
DB_HOST=db
DB_PORT=5432

# Safaricom Daraja
DARAJA_CONSUMER_KEY=your_daraja_consumer_key
DARAJA_CONSUMER_SECRET=your_daraja_consumer_secret
DARAJA_SHORTCODE=174379
DARAJA_TILL_NUMBER=174379
DARAJA_PASSKEY=your_daraja_passkey
DARAJA_CALLBACK_URL=https://yourdomain.com/api/payments/callback/
DARAJA_ENV=sandbox

# CORS / Frontend
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Rate Limiting
THROTTLE_ANON=100/day
THROTTLE_USER=1000/day

# Django Admin
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@coinhub.co.ke
DJANGO_SUPERUSER_PASSWORD=Admin@CoinHub2025!
